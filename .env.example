# cp .env.example .env 한 뒤 값을 채운다.
# ⚠ cp 를 다시 돌리면 채워둔 값이 덮어써진다.
#
# 값은 비워 둔다. 자리표시자를 넣어두면 그대로 복사돼서 "설정된 것처럼" 보이고,
# 앱이 가짜 주소로 접속을 시도한다 (비어 있으면 로컬 state 로 돈다).

# 브라우저에 노출됨 (anon key만). 예: https://xxxx.supabase.co / eyJ...
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버(Vercel function / 로컬 스크립트)에서만 사용. 절대 VITE_ 접두사 붙이지 말 것
# Claude API 키. platform.claude.com (구 console.anthropic.com) → API Keys → Create Key.
# 'sk-ant-api03-' 로 시작하는 긴 문자열. 발급 직후 한 번만 보여주니 바로 여기 붙여넣는다.
# claude.ai 구독(Pro/Max)과는 별개다 — API 콘솔에서 크레딧을 따로 충전해야 호출된다.
LLM_API_KEY=
# 키가 'sk-ant-usr-' 로 시작하는 사용자 키면 워크스페이스 ID 가 추가로 필요하다 (없으면 400).
# 콘솔 → Workspaces → 해당 워크스페이스 → ID (wrkspc_…). 워크스페이스 키(sk-ant-api03-)면 비워 둔다.
LLM_WORKSPACE_ID=
# 판별은 짧은 분류라 Sonnet 5.5 로 충분하다 ($2/$10 per MTok). 더 세게 보려면 claude-opus-5-5
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.anthropic.com

# 서버 판정에서 answers 양쪽을 읽을 때만 (sb_secret_…). 브라우저로 가면 RLS가 전부 무의미해진다
SUPABASE_SERVICE_ROLE_KEY=

# 설계사 콘솔 입장 코드 (임시 인증. docs/00 P0-4 의 이메일 로그인으로 바꿀 때까지).
# 아무 문자열. dev 에서 비워두면 "dev". 배포에서는 반드시 넣는다
PLANNER_PASSCODE=

# /api/judge 가 카드 본문을 클라이언트에서 그대로 받는 데모 모드.
# 1주차 시연용. 공개 배포에서는 끈다 (끄면 403 — 열린 LLM 프록시가 되지 않는다)
ALLOW_DEMO_JUDGE=1

# 🔴 건 설계사용 3줄 요약 (AI 활용 2번). 켜면 text 가 아닌 카드의 '요약'도 LLM을 쓴다.
# 판별은 여전히 text 카드만 LLM을 쓴다 (docs/02)
ENABLE_PLANNER_SUMMARY=0
