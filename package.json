{
  "name": "dongunghap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "shots": "node shoot.mjs",
    "ping": "node scripts/ping-llm.mjs",
    "sql:bundle": "cat supabase/reset.sql supabase/schema.sql supabase/rls.sql supabase/seed.sql > supabase/_all.sql && echo \"supabase/_all.sql 생성 (reset 포함, 다시 돌려도 됨) — pbcopy < supabase/_all.sql\"",
    "ping:db": "node scripts/ping-db.mjs",
    "sim": "node scripts/sim-partner.mjs",
    "e2e": "node --env-file=.env --import tsx scripts/e2e-live.mts",
    "seed:samples": "node --env-file=.env --import tsx scripts/seed-samples.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@supabase/supabase-js": "^2.117.3",
    "pdfjs-dist": "6.4.299",
    "pretendard": "^1.3.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.64.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.5"
  }
}
